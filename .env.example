# Copy to .env on the server and adjust.
# IMAGE is the full image reference compose should run,
# e.g. your local registry plus image name/tag:
IMAGE=localhost:5000/elsewhere:latest

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Reminders (Web Push) — see docs/adr/0001-web-push-notifications.md ──────
#
# Generate ONCE and keep the private key. Generating a new keypair
# invalidates every existing subscription and forces a re-permission prompt
# on every device, which looks like it worked while silently breaking all of
# them.
#
#   npx web-push generate-vapid-keys
#
# Without these the app runs fine; reminders are simply unavailable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guards POST /api/push/remind so an unauthenticated caller cannot spam
# every registered device. Required — the route refuses to run without it.
# Then point a cron at it, e.g. hourly:
#   curl -X POST -H "x-reminder-token: $REMINDER_TOKEN" \
#        http://localhost:3001/api/push/remind
REMINDER_TOKEN=